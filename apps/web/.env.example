# apps/web/.env
# Base path the client uses for API calls. Keep "/api/v1" for both local dev
# (Vite proxy → apps/api) and production when the web deployment rewrites
# /api/* to the API deployment (see apps/web/vercel.json). Only set an absolute
# URL if the browser should call the API cross-origin directly.
VITE_API_BASE_URL="/api/v1"

# Dev-only: where the Vite dev proxy forwards /api and /uploads.
VITE_API_PROXY="http://localhost:4000"
