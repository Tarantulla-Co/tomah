# ---------------------------------------------------------------------------
# Tomah monorepo — root environment template
# Copy to .env at the repo root, then also copy the per-app templates:
#   cp .env.example .env
#   cp packages/db/.env.example packages/db/.env
#   cp apps/api/.env.example    apps/api/.env
#   cp apps/web/.env.example    apps/web/.env
#
# apps/storefront has its own .env — see apps/storefront/README.
# For production (Vercel + Supabase) do NOT use .env files; set the variables
# in each Vercel project's dashboard. See docs/DEPLOY.md.
# ---------------------------------------------------------------------------

# Shared Postgres connection (used by packages/db and apps/api).
# Local dev via Docker:  docker compose up -d db
DATABASE_URL="postgresql://tomah:tomah@localhost:5432/tomah_admin?schema=public"
DIRECT_URL="postgresql://tomah:tomah@localhost:5432/tomah_admin?schema=public"
