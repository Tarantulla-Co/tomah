# apps/api/.env  — copy from this file and fill in.
# Production: set these in the Vercel "tomah-api" project instead. See docs/DEPLOY.md.

NODE_ENV=development
PORT=4000

# Must match packages/db/.env and the root .env.
# Local: pooled == direct. Supabase: DATABASE_URL = :6543 pooler (+pgbouncer=true),
# DIRECT_URL = :5432 direct.
DATABASE_URL="postgresql://tomah:tomah@localhost:5432/tomah_admin?schema=public"
DIRECT_URL="postgresql://tomah:tomah@localhost:5432/tomah_admin?schema=public"

# Auth — generate long random strings for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Refresh-token cookie.
# Local dev:                 COOKIE_DOMAIN=localhost  COOKIE_SECURE=false COOKIE_SAMESITE=lax
# Prod, web proxies /api  :  COOKIE_DOMAIN=           COOKIE_SECURE=true  COOKIE_SAMESITE=lax
# Prod, web calls API x-site: COOKIE_DOMAIN=          COOKIE_SECURE=true  COOKIE_SAMESITE=none
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — comma-separated allowed origins (the admin web app; add the storefront
# origin if it calls the authenticated API). Only needed when the browser hits
# the API cross-origin; harmless to set regardless.
CORS_ORIGINS="http://localhost:5173"

# ---- Asset storage (product images) ----
# "local"    — writes to disk, served by this API (dev only; NOT on Vercel).
# "supabase" — Supabase Storage bucket (production).
STORAGE_ADAPTER=local
STORAGE_LOCAL_DIR=uploads
ASSET_PUBLIC_BASE_URL=/uploads
MAX_UPLOAD_MB=8

# Required when STORAGE_ADAPTER=supabase. The bucket must be PUBLIC (read).
# SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role key — server only, never ship to the browser>"
# SUPABASE_STORAGE_BUCKET=product-images

# ---- Payments ----
# "manual" — no online collection, staff record payments by hand (default, no
#            external account needed for local dev).
# "stripe" — live collection: PaymentIntents + webhook. Apple Pay / Google Pay
#            appear automatically on the storefront's Payment Element once
#            enabled in the Stripe Dashboard (Settings -> Payment methods).
PAYMENT_PROVIDER=manual
# Required when PAYMENT_PROVIDER=stripe. See docs/DEPLOY.md "Testing the real
# Stripe flow locally" for how to get test keys + a webhook secret via the
# Stripe CLI.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

ACCOUNTING_ADAPTER=noop
INVOICE_DUE_DAYS=14
